{
  "schema": "starcrew.ship-layout/2",
  "ship": {
    "id": "tern",
    "name": "SCS Tern",
    "class": "Heron-class frigate",
    "summary": "The reference ship: a 84 m frigate with a crew of four to eight, two fighters and a shuttle.",
    "presented_by": "openspec/changes/reference-ship-tern"
  },
  "conventions": {
    "units": "metres, degrees",
    "axes": "ship-local, right-handed: +X port, +Y dorsal (up), +Z bow (forward)",
    "origin": "on the centreline, on deck B's floor, at the hangar's forward wall",
    "yaw_deg": "rotation about +Y; 0 faces the bow (+Z), +90 faces port (+X)",
    "finish": "a compartment's surface finish, 'crew' or 'working': which materials its generated surfaces take (data/ships/<id>/detailing.json, finishes)",
    "brush": "a convex prism: 'poly' is its footprint, [x, z] corners in order with positive signed area (sum of x_i z_(i+1) - x_(i+1) z_i), and 'y' is [floor, ceiling]; the inner surfaces (air) of the compartment, whose air is the union of its brushes. Brushes of one compartment may share a face (it is open between them) but never overlap",
    "portal_size_m": "a wall portal: [width along the wall, height]; a floor portal: [x, z] extents",
    "portal_center_m": "centre of the opening, on the plane where the two compartments meet",
    "portal_normal": "unit vector from between[0] into between[1]: horizontal for a wall portal (the wall's normal, which need not be axis-aligned), [0, 1, 0] or [0, -1, 0] for a floor portal (a hatch, ladder, hoist or bay door)",
    "wall_thickness_m": 0.25,
    "deck_slab_m": 0.5
  },
  "decks": [
    { "id": "A", "name": "Command deck", "floor_y_m": 3.5, "clear_height_m": 3.0 },
    { "id": "B", "name": "Main deck", "floor_y_m": 0.0, "clear_height_m": 3.0 },
    { "id": "C", "name": "Lower deck", "floor_y_m": -3.5, "clear_height_m": 3.0 }
  ],
  "hull": {
    "note": "Octagonal cross-sections lofted linearly along Z. chamfer_m cuts each corner at 45 degrees. clearance_m is the least distance from any compartment's air (pods excepted) to the hull's skin: plating, frames and insulation.",
