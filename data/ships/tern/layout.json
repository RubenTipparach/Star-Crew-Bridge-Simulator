{
  "schema": "starcrew.ship-layout/1",
  "ship": {
    "id": "tern",
    "name": "SCS Tern",
    "class": "Heron-class frigate",
    "summary": "The reference ship: a 84 m frigate with a crew of four to eight, two fighters and a shuttle.",
    "presented_by": "openspec/changes/reference-ship-tern"
  },
  "conventions": {
    "units": "metres, degrees",
    "axes": "ship-local, right-handed: +X port, +Y dorsal (up), +Z bow (forward)",
    "origin": "on the centreline, on deck B's floor, at the hangar's forward wall",
    "yaw_deg": "rotation about +Y; 0 faces the bow (+Z), +90 faces port (+X)",
    "box": "axis-aligned, [min, max] per axis, inner surfaces (air) of the compartment",
    "portal_size_m": "opening width and height: axis x -> [z, y], axis z -> [x, y], axis y -> [x, z]",
    "portal_center_m": "centre of the opening, on the plane where the two compartments meet",
    "wall_thickness_m": 0.25,
    "deck_slab_m": 0.5
  },
  "decks": [
    { "id": "A", "name": "Command deck", "floor_y_m": 3.5, "clear_height_m": 3.0 },
