{
  "schema": "starcrew.chat/1",
  "_doc": "Crew chat's vocabulary (openspec/changes/crew-chat design 2-4; owner, 2026-10-14: 'create a chat window for the bots to communicate orders, acknowledgements and intents like firing torpedos, targeting enemy, warping to coordinates, repairing hull etc....'). kinds: each kind's label, colour (sRGB 0-255, the console's) and shape (chevron, tick, arrow, square or none); colour always comes with its shape. limits: line_chars, the longest NPC template, characters; keep_lines, the lines the server keeps and sends a late joiner; speaker_gap_s, a player's least time between lines, seconds (the server drops a faster one); npc_gap_s, an NPC's least time between lines, seconds (it says the most important of what it had); repeat_s, an NPC never repeats a text within it, seconds; strip_lines and strip_fade_s, the in-game strip's lines and how long each stays, seconds; log_lines, the log window's lines seen at once. speakers: the server's own voices. report_steps_pct: the computer reports the hull and the shields as they fall past each, percent of full. orders and acks: one line per verb the captain can send a station (data/stations.json 'orders'), keyed by station id and verb. lines: every other line the engine speaks, by id: its kind, its text and its rank (1 most important; an NPC with several lines to say says the lowest rank). Slots a template may use: {target} the enemy's class name, {tube} 1-based, {station}, {preset} a shield or power preset, {band} A-D, {room} and {system} their layout.json names, {pct}, {heading} and {pitch} whole degrees.",
  "kinds": {
    "say": { "label": "SAY", "colour": [222, 230, 238], "shape": "none" },
    "order": { "label": "ORDER", "colour": [88, 200, 232], "shape": "chevron" },
    "ack": { "label": "ACK", "colour": [112, 204, 122], "shape": "tick" },
    "intent": { "label": "INTENT", "colour": [242, 160, 70], "shape": "arrow" },
    "report": { "label": "REPORT", "colour": [190, 160, 230], "shape": "square" }
  },
  "limits": {
    "line_chars": 64,
    "keep_lines": 40,
    "speaker_gap_s": 1.0,
    "npc_gap_s": 2.5,
    "repeat_s": 20.0,
    "strip_lines": 3,
    "strip_fade_s": 6.0,
    "log_lines": 14
  },
  "speakers": { "computer": "Computer", "damage_control": "Damage control" },
